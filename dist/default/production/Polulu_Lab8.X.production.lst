 19697   300000                     	org	3145728
 19698   300000  EC                 	db	236
 19699                           
 19700                           ;Config register CONFIG1H @ 0x300001
 19701                           ;	Clock out Enable bit
 19702                           ;	CLKOUTEN = ON, CLKOUT function is enabled
 19703                           ;	PRLOCKED One-Way Set Enable bit
 19704                           ;	PR1WAY = ON, PRLOCK bit can be cleared and set only once
 19705                           ;	Clock Switch Enable bit
 19706                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
 19707                           ;	Fail-Safe Clock Monitor Enable bit
 19708                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
 19709   300001                     	org	3145729
 19710   300001  FE                 	db	254
 19711                           
 19712                           ;Config register CONFIG2L @ 0x300002
 19713                           ;	MCLR Enable bit
 19714                           ;	MCLRE = EXTMCLR, If LVP = 0, MCLR pin is MCLR; If LVP = 1, RE3 pin function is MCLR
 19715                           ;	Power-up timer selection bits
 19716                           ;	PWRTS = PWRT_OFF, PWRT is disabled
 19717                           ;	Multi-vector enable bit
 19718                           ;	MVECEN = OFF, Interrupt contoller does not use vector table to prioritze interrupts
 19719                           ;	IVTLOCK bit One-way set enable bit
 19720                           ;	IVT1WAY = ON, IVTLOCK bit can be cleared and set only once
 19721                           ;	Low Power BOR Enable bit
 19722                           ;	LPBOREN = OFF, ULPBOR disabled
 19723                           ;	Brown-out Reset Enable bits
 19724                           ;	BOREN = SBORDIS, Brown-out Reset enabled , SBOREN bit is ignored
 19725   300002                     	org	3145730
 19726   300002  F7                 	db	247
 19727                           
 19728                           ;Config register CONFIG2H @ 0x300003
 19729                           ;	Brown-out Reset Voltage Selection bits
 19730                           ;	BORV = VBOR_2P45, Brown-out Reset Voltage (VBOR) set to 2.45V
 19731                           ;	ZCD Disable bit
 19732                           ;	ZCD = OFF, ZCD disabled. ZCD can be enabled by setting the ZCDSEN bit of ZCDCON
 19733                           ;	PPSLOCK bit One-Way Set Enable bit
 19734                           ;	PPS1WAY = ON, PPSLOCK bit can be cleared and set only once; PPS registers remain locke
      +                          d after one clear/set cycle
 19735                           ;	Stack Full/Underflow Reset Enable bit
