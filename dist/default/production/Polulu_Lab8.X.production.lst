 18930                           ;	RSTOSC = HFINTOSC_1MHZ, HFINTOSC with HFFRQ = 4 MHz and CDIV = 4:1
 18931   300000                     	org	3145728
 18932   300000  EC                 	db	236
 18933                           
 18934                           ;Config register CONFIG1H @ 0x300001
 18935                           ;	Clock out Enable bit
 18936                           ;	CLKOUTEN = ON, CLKOUT function is enabled
 18937                           ;	PRLOCKED One-Way Set Enable bit
 18938                           ;	PR1WAY = ON, PRLOCK bit can be cleared and set only once
 18939                           ;	Clock Switch Enable bit
 18940                           ;	CSWEN = ON, Writing to NOSC and NDIV is allowed
 18941                           ;	Fail-Safe Clock Monitor Enable bit
 18942                           ;	FCMEN = ON, Fail-Safe Clock Monitor enabled
 18943   300001                     	org	3145729
 18944   300001  FE                 	db	254
 18945                           
 18946                           ;Config register CONFIG2L @ 0x300002
 18947                           ;	MCLR Enable bit
 18948                           ;	MCLRE = EXTMCLR, If LVP = 0, MCLR pin is MCLR; If LVP = 1, RE3 pin function is MCLR
 18949                           ;	Power-up timer selection bits
 18950                           ;	PWRTS = PWRT_OFF, PWRT is disabled
 18951                           ;	Multi-vector enable bit
 18952                           ;	MVECEN = OFF, Interrupt contoller does not use vector table to prioritze interrupts
 18953                           ;	IVTLOCK bit One-way set enable bit
 18954                           ;	IVT1WAY = ON, IVTLOCK bit can be cleared and set only once
 18955                           ;	Low Power BOR Enable bit
 18956                           ;	LPBOREN = OFF, ULPBOR disabled
 18957                           ;	Brown-out Reset Enable bits
 18958                           ;	BOREN = SBORDIS, Brown-out Reset enabled , SBOREN bit is ignored
 18959   300002                     	org	3145730
 18960   300002  F7                 	db	247
 18961                           
 18962                           ;Config register CONFIG2H @ 0x300003
 18963                           ;	Brown-out Reset Voltage Selection bits
